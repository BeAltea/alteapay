# ==============================================
# Altea Pay - Environment Variables
# ==============================================

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==============================================
# Supabase Configuration
# ==============================================
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_jwt_secret

# ==============================================
# ASAAS Payment Gateway
# ==============================================
# Production: https://api.asaas.com/v3
# Sandbox: https://api-sandbox.asaas.com/v3
ASAAS_API_URL=https://api.asaas.com/v3

# API Key from ASAAS Dashboard -> Menu -> Integrações -> API
# IMPORTANT: If your key starts with $ (e.g., $aact_prod_...), escape it with backslash:
# ASAAS_API_KEY=\$aact_prod_xxx::yyy::\$aach_zzz
ASAAS_API_KEY=your_asaas_api_key

# Webhook Token for validating incoming webhook requests
# Generate a secure random string (e.g., openssl rand -hex 32)
# Configure this same token in ASAAS Dashboard -> Webhooks -> Access Token
ASAAS_WEBHOOK_TOKEN=your_secure_webhook_token

# ==============================================
# Assertiva Credit Analysis & Localize
# ==============================================
ASSERTIVA_BASE_URL=https://api.assertivasolucoes.com.br
ASSERTIVA_CLIENT_ID=your_assertiva_client_id
ASSERTIVA_CLIENT_SECRET=your_assertiva_client_secret
ASSERTIVA_CALLBACK_URL=https://your-domain.com/api/assertiva/callback
# Finalidade ID for Localize API (2 = Ciclo de crédito - cobrança/verificação)
ASSERTIVA_FINALIDADE_ID=2

# ==============================================
# Twilio SMS/WhatsApp
# ==============================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_MESSAGING_SERVICE_SID=your_messaging_service_sid
TWILIO_PHONE_NUMBER=+1234567890

# ==============================================
# Email Services (SendGrid via Queue)
# ==============================================
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=cobranca@alteapay.com
SENDGRID_FROM_NAME=AlteaPay

# ==============================================
# Redis (BullMQ Queue - Upstash)
# ==============================================
# Used for email and charge queues processed by Fargate workers
# Format: rediss://default:password@hostname:6379
REDIS_URL=your_redis_url

# ==============================================
# Cron Jobs
# ==============================================
# Secret token for authenticating cron job requests
CRON_SECRET=your_cron_secret

# ==============================================
# ASAAS Webhook Configuration Guide
# ==============================================
#
# 1. Go to ASAAS Dashboard -> Menu do Usuário -> Integrações -> Webhooks
#
# 2. Create a new webhook with:
#    - URL: https://your-domain.com/api/asaas/webhook/payments
#    - OR (legacy): https://your-domain.com/api/webhooks/asaas
#
# 3. Select events to receive:
#    - PAYMENT_CREATED
#    - PAYMENT_AWAITING_RISK_ANALYSIS
#    - PAYMENT_PENDING
#    - PAYMENT_CONFIRMED
#    - PAYMENT_RECEIVED
#    - PAYMENT_OVERDUE
#    - PAYMENT_DELETED
#    - PAYMENT_REFUNDED
#    - PAYMENT_REFUND_REQUESTED
#    - PAYMENT_UPDATED
#    - PAYMENT_CREDIT_CARD_CAPTURE_REFUSED
#    - PAYMENT_DUNNING_RECEIVED
#    - PAYMENT_DUNNING_REQUESTED
#
# 4. Set Access Token to the same value as ASAAS_WEBHOOK_TOKEN above
#
# 5. Test the webhook using ASAAS sandbox environment
#
# Note: The webhook handler will:
#    - Validate the token from request headers
#    - Log all events to asaas_webhook_events table
#    - Deduplicate repeated events
#    - Update agreement status, payment status, and debt status
#    - Create notifications for customers
#
# ==============================================

# ==============================================
# CHATBOT DE NEGOCIAÇÃO + INTEGRAÇÃO N8N
# ==============================================
# Agente de negociação (serviço externo; BFF fala server-to-server)
NEGOTIATION_AGENT_URL=
# Token compartilhado app<->agente (x-app-token / x-agent-token)
APP_SHARED_TOKEN=
AGENT_APP_TOKEN=
# JWT do cookie de sessão do chat (fallback: SUPABASE_JWT_SECRET)
NEGOTIATION_JWT_SECRET=
# TTL do token de handoff (deep link /negociar/<token>), horas
NEGOTIATION_TOKEN_TTL_HOURS=24
# Modelo registrado na auditoria de mensagens
NEGOTIATION_MODEL=

# Webhook n8n (/api/webhooks/n8n) — HMAC compartilhado com os fluxos
N8N_WEBHOOK_SECRET=

# Canal WhatsApp do chatbot (DORMANTE: manter 0 até go-live do canal)
WHATSAPP_CHANNEL_ENABLED=0
WHATSAPP_BSP_PROVIDER=mock
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Jornada WhatsApp via Voxuy (campanhas). Default seguro: mock em TODOS os
# tenants reais. Só preencher os VOXUY_* no tenant de teste liberado.
# Provider da campanha: "mock" (default) | "voxuy" (por tenant via
# tenant_chat_config.whatsapp_provider). Ver docs/WHATSAPP_VOXUY_INTEGRATION.md.
WHATSAPP_PROVIDER=mock
# URL COMPLETA de Integrações → API VOXUY (contém o <codigo>; não concatenar). ECS.
VOXUY_WEBHOOK_URL=
# Campo apiToken do corpo. ECS.
VOXUY_API_TOKEN=
# Segredo da rota de captura /api/webhooks/whatsapp/voxuy (header x-alteapay-webhook-secret ou ?s=). Netlify.
VOXUY_INBOUND_SECRET=
# Timeout do POST à Voxuy (ms). ECS.
VOXUY_TIMEOUT_MS=10000
# Limiter conservador da fila (Voxuy não documenta rate limit). ECS.
WHATSAPP_RATE_LIMIT_PER_SEC=5
# Por tenant (tenant_chat_config): voxuy_plan_id (text), voxuy_events (jsonb:
# {"approach":63,"stop":64,"receipt":null}), whatsapp_provider.

# Engine da conversa: "n8n" (padrão — fluxos n8n são o cérebro) ou "agent"
# (agente LangGraph legado, apenas rig de treino local)
NEGOTIATION_ENGINE=n8n
# Fluxo n8n que conduz o turno de conversa (Webhook trigger + Respond to Webhook)
N8N_CHAT_FLOW_URL=
# Opcional: fluxo notificado na criação de sessão (session.init)
N8N_SESSION_FLOW_URL=
# Timeout da chamada ao fluxo (ms)
N8N_FLOW_TIMEOUT_MS=60000
# N8N-2: adaptador dos botões legados do n8n (ids string, `text`, PIX/CARTAO,
# {sessionId,output,buttons}). off = só a forma canônica (default seguro).
N8N_LEGACY_BUTTONS_ADAPTER=off

# -----------------------------------------------------------------------------
# Integração n8n + latência (2026-09-28). Todos os defaults abaixo preservam o
# comportamento atual de produção, EXCETO as mudanças intencionais listadas em
# ops/negociacao-final/13-plano-rollout-integracao.md §2 (rate limit por
# identidade no webhook n8n, guards de dívida quitada, latência, época da
# thread, guard de texto do n8n, rótulo do servidor nos botões de oferta).
# -----------------------------------------------------------------------------
# N8N-4: segredo ANTERIOR aceito só na ENTRADA durante a rotação (a saída
# assina sempre com N8N_WEBHOOK_SECRET). Vazio = só o atual (hoje).
N8N_WEBHOOK_SECRET_PREVIOUS=
# N8N-16: exigir que todo callback com efeito ecoe um evento enviado pela
# plataforma (origin_event_id). off (default) = só telemetria n8n.correlation_miss.
N8N_REQUIRE_EVENT_CORRELATION=off
# Janela (s) e teto de respostas por evento de origem da correlação.
N8N_CORRELATION_WINDOW_SECONDS=900
N8N_CORRELATION_MAX_REPLIES=12
# Ação session.create do webhook n8n (fora da correlação). off (default) = 403
# n8n_session_create_disabled. Nenhum fluxo usa; só ligar com revisão.
N8N_SESSION_CREATE_ENABLED=off
# N8N-12: rate limit do /api/webhooks/n8n. identity (default) = por sessão e
# por cedente (MUDANÇA INTENCIONAL); legacy = 120/min por IP, como antes.
N8N_RATE_LIMIT_MODE=identity
N8N_RL_UNSIGNED_PER_MIN=60
N8N_RL_SESSION_PER_MIN=60
N8N_RL_COMPANY_PER_MIN=3000
N8N_RL_SIGNED_MISC_PER_MIN=300
N8N_RL_LEGACY_IP_PER_MIN=120
# F-4: de onde vem o IP do cliente. legacy/vazio (default) = lógica de hoje;
# "none" | lista de edge,netlify,xff. Só trocar depois do teste de duas redes.
TRUSTED_CLIENT_IP_SOURCE=legacy
TRUSTED_PROXY_HOPS=1
# Segredo HMAC do cabeçalho x-alteapay-client-ip assinado no middleware (fonte "edge").
CLIENT_IP_HEADER_SECRET=
# Sal do hash de IP gravado como telemetria (>= 16 caracteres para valer).
CLIENT_IP_HASH_SALT=
# Token da rota de diagnóstico /api/debug/client-ip (vazio = rota desligada).
CLIENT_IP_DEBUG_TOKEN=
# Bloqueio de login por IP (já existia; default off).
AUTH_IP_LOCK_ENABLED=false
# N8N-10: engine_outbox (session.start). Sem a migration o outbox é no-op e a
# ausência da tabela é revista a cada ENGINE_OUTBOX_RECHECK_MS.
ENGINE_OUTBOX_RECHECK_MS=300000
ENGINE_OUTBOX_TIMEOUT_MS=2500
ENGINE_OUTBOX_MAX_ATTEMPTS=6
ENGINE_OUTBOX_BACKOFF_BASE_MS=30000
ENGINE_OUTBOX_LEASE_MS=60000
# Orçamento do dreno por chamada da cron /api/cron/flush-engine-outbox (Bearer CRON_SECRET).
ENGINE_OUTBOX_DRAIN_BUDGET_MS=8000
# Dreno no worker Fargate (0 = desligado).
ENGINE_OUTBOX_DRAIN_INTERVAL_MS=15000
# Fluxo n8n dedicado a eventos (session.start); vazio = usa N8N_CHAT_FLOW_URL.
N8N_EVENT_FLOW_URL=
# Latência: trabalho opcional pós-resposta. Vazio = waitUntil da plataforma se
# existir, senão inline (como antes). "background" só em servidor de longa duração.
AFTER_RESPONSE_MODE=
