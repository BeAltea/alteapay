### chat.send — empurra mensagem (+ prompt opcional + payment_ref) ao chat do cliente
# Dedupe por event_id (24h): reenviar devolve o mesmo message_id com duplicate:true.
POST https://alteapay.com/api/webhooks/n8n
Content-Type: application/json
x-alteapay-signature: <HMAC_HEX>
x-alteapay-timestamp: <EPOCH_SEGUNDOS>

{
  "action": "chat.send",
  "session_id": "<UUID_SESSAO>",
  "event_id": "<UUID_EVENTO>",
  "args": {
    "text": "Segue seu PIX abaixo 👇",
    "prompt": {
      "kind": "payment_method_choice",
      "question": "Como prefere pagar?",
      "buttons": [ { "id": 2, "label": "PIX", "value": "PIX" }, { "id": 3, "label": "Boleto", "value": "BOLETO" } ]
    },
    "payment_ref": { "agreement_id": "<UUID>" },
    "n8n_execution_id": "exec_9"
  }
}

### Resposta esperada
# 200 { "ok": true, "message_id": "<UUID>", "prompt_id": "<UUID|null>", "duplicate": false }
# 422 { "ok": false, "code": "button_id_duplicate" }  (botões inválidos)
