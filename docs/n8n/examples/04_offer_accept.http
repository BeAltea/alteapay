### offer.accept — aceita uma oferta (prefira payment.create)
POST https://alteapay.com/api/webhooks/n8n
Content-Type: application/json
x-alteapay-signature: <HMAC_HEX>
x-alteapay-timestamp: <EPOCH_SEGUNDOS>

{ "action": "offer.accept", "session_id": "<UUID_SESSAO>", "event_id": "<UUID_EVENTO>", "args": { "offer_id": "<UUID_OFERTA>" } }

### Resposta esperada
# 200 { "success": true, "agreement_id": "<UUID>" }
# 409 { "success": false, "error": "OFFER_EXPIRED" }
